<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<StartupObject>Basis.Program</StartupObject>
	</PropertyGroup>
	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
	</PropertyGroup>
	<ItemGroup>
	  <ProjectReference Include="..\..\BasisNetworkClient\BasisNetworkClient.csproj" />
	  <ProjectReference Include="..\..\BasisNetworkCore\BasisNetworkCore.csproj" />
	  <ProjectReference Include="..\..\Contrib\Auth\Did\Did.csproj" />
	  <ProjectReference Include="..\..\Contrib\Crypto\Crypto.csproj" />
	  <ProjectReference Include="..\..\LiteNetLib\LiteNetLib.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <!-- Same version as BasisNetworkServer — the face observer decodes channel-52 avatar bundles. -->
	  <PackageReference Include="K4os.Compression.LZ4" Version="1.3.8" />
	</ItemGroup>
	<!--
	  Real Opus, compiled from the same OpusSharp the Unity client uses, so simulated voice is
	  decodable rather than random bytes: a real player joining the load test hears a tone instead of
	  a decoder error, and frame sizes follow Opus VBR instead of a made-up constant.
	  OpusSharp.Core is pure P/Invoke with no UnityEngine references, so it compiles here unchanged.
	-->
	<ItemGroup>
	  <Compile Include="$(OpusSharpDir)\**\*.cs" LinkBase="OpusSharp" />
	  <None Include="$(OpusSharpDir)\..\Plugins\win-x64\native\opus.dll" CopyToOutputDirectory="PreserveNewest" Link="opus.dll" />
	</ItemGroup>
	<PropertyGroup>
	  <OpusSharpDir>$(MSBuildThisFileDirectory)..\..\..\Basis\Packages\com.avionblock.opussharp\OpusSharp.Core</OpusSharpDir>
	</PropertyGroup>
</Project>
