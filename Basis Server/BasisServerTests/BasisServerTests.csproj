<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <IsPublishable>false</IsPublishable>
    <LangVersion>13</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <!-- GpuLz4Experiment only; nothing the server ships uses it. -->
    <PackageReference Include="ILGPU" Version="1.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BasisNetworkCore\BasisNetworkCore.csproj" />
    <ProjectReference Include="..\BasisNetworkServer\BasisNetworkServer.csproj" />
    <!-- Present so the runtime lookup under test has something to find; never referenced in code. -->
    <ProjectReference Include="..\BasisNetworkCompute\BasisNetworkCompute.csproj" />
    <ProjectReference Include="..\Contrib\Auth\Did\Did.csproj" />
    <ProjectReference Include="..\Contrib\Crypto\Crypto.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\BasisServerConsole\BasisControlProtocol.cs" Link="Console\BasisControlProtocol.cs" />
    <Compile Include="..\BasisServerConsole\BasisControlServer.cs" Link="Console\BasisControlServer.cs" />
    <Compile Include="..\BasisServerConsole\BasisSystemLog.cs" Link="Console\BasisSystemLog.cs" />
    <Compile Include="..\BasisServerConsole\BasisSystemd.cs" Link="Console\BasisSystemd.cs" />
  </ItemGroup>
</Project>
