<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement class="bvp-root">
        <engine:VisualElement name="HeaderCard" class="bvp-card bvp-header-card">
            <engine:Label text="Basis Media Diagnostics" name="HeaderTitle" selectable="false" class="bvp-header-title"/>
            <engine:Label text="Per-frame CSV logger (sandboxed to persistentDataPath)" name="HeaderSubtitle" selectable="false" class="bvp-header-subtitle"/>
        </engine:VisualElement>

        <engine:Foldout text="Logging" name="LoggingFoldout" value="true" class="bvp-foldout">
            <engine:Toggle label="Auto Start" name="AutoStartField" tooltip="Begin writing CSV on OnEnable."/>
            <engine:IntegerField label="Flush Every N Rows" name="FlushEveryField" tooltip="Rows are written once per Unity frame; this caps how many are held before a flush."/>
            <engine:Toggle label="Append Between Sessions" name="AppendField" tooltip="If OFF, the file is truncated on each StartLogging()."/>
            <engine:TextField label="Log Path Override" name="LogPathOverrideField" tooltip="Sandboxed to persistentDataPath. Empty = default BasisMediaFrames.csv."/>
            <engine:Label text="The engine writes its own capture separately (the player's Diagnostics Csv Path), sampled on its own thread. This file is the other side of the boundary: render cadence, frame hold times and audio pull, which the engine cannot observe." name="LoggingHelp" class="bvp-help-info"/>
        </engine:Foldout>

        <engine:Foldout text="Live Status" name="StatusFoldout" value="true" class="bvp-foldout">
            <engine:VisualElement class="bvp-status-grid">
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Is Logging" name="StatusIsLoggingLabel" class="bvp-status-label"/><engine:Label text="—" name="StatusIsLogging" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Rows Written" name="StatusRowsLabel" class="bvp-status-label"/><engine:Label text="—" name="StatusRows" class="bvp-status-value"/></engine:VisualElement>
            </engine:VisualElement>
            <engine:Label text="Resolved Path:" name="StatusResolvedPathTitle" class="bvp-section-title" style="margin-top: 6px;"/>
            <engine:Label text="—" name="StatusResolvedPath" class="bvp-counters"/>
            <engine:Label text="—" name="StatusError" class="bvp-help-error"/>
            <engine:Label text="Enter Play Mode to start/stop logging and see live counters." name="StatusEditModeHint" class="bvp-help-info"/>
        </engine:Foldout>

        <engine:VisualElement name="ActionsCard" class="bvp-card bvp-actions-card">
            <engine:Button text="Start" name="ActStartButton" class="bvp-primary-button"/>
            <engine:Button text="Stop" name="ActStopButton" class="bvp-secondary-button"/>
            <engine:Button text="Flush" name="ActFlushButton" class="bvp-secondary-button"/>
            <engine:Button text="Reveal" name="ActRevealButton" class="bvp-secondary-button"/>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
