.bvp-root {
    flex-grow: 1;
}

.bvp-card {
    background-color: rgba(0, 0, 0, 0.54);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-width: 10px;
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-bottom: 5px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 6px;
    padding-right: 6px;
}

/* A boxed group inside a card: the per-platform URL toggle and the fields it
   governs, drawn together so the toggle visibly owns them. */
.bvp-subgroup {
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(255, 255, 255, 0.18);
    border-right-color: rgba(255, 255, 255, 0.18);
    border-top-color: rgba(255, 255, 255, 0.18);
    border-bottom-color: rgba(255, 255, 255, 0.18);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 5px;
    padding-right: 5px;
    margin-bottom: 6px;
}

.bvp-header-card {
    padding-top: 0;
    padding-bottom: 0;
    padding-left: 0;
    padding-right: 0;
}

.bvp-header-title {
    -unity-font-style: bold;
    font-size: 48px;
    -unity-text-align: upper-center;
    color: rgb(239, 40, 90);
    margin-top: 4px;
}

.bvp-header-subtitle {
    -unity-text-align: upper-center;
    color: rgb(190, 190, 190);
    font-size: 12px;
    margin-bottom: 6px;
}

.bvp-section-title {
    -unity-font-style: bold;
    font-size: 14px;
    color: rgb(239, 40, 90);
    margin-bottom: 4px;
}

.bvp-subgroup-title {
    -unity-font-style: bold;
    font-size: 11px;
    color: rgba(255, 255, 255, 0.62);
    margin-bottom: 3px;
}

.bvp-foldout {
    background-color: rgba(0, 0, 0, 0.54);
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-bottom-width: 10px;
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-bottom: 5px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-top: 2px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

.bvp-foldout > .unity-foldout__content {
    margin-left: 4px;
    -unity-font-style: normal;
}

.bvp-status-grid {
    flex-direction: column;
}

.bvp-status-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 2px;
    padding-bottom: 2px;
    padding-left: 4px;
    padding-right: 4px;
}

.bvp-status-label {
    -unity-font-style: normal;
    color: rgb(200, 200, 200);
    flex-grow: 1;
}

.bvp-status-value {
    -unity-font-style: bold;
    color: rgb(230, 230, 230);
}

.bvp-status-value-wrap {
    white-space: normal;
    flex-shrink: 1;
    -unity-text-align: middle-right;
}

.bvp-status-pill {
    -unity-font-style: bold;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    padding-top: 1px;
    padding-bottom: 1px;
    padding-left: 8px;
    padding-right: 8px;
    -unity-text-align: middle-center;
    min-width: 44px;
}

.bvp-pill-neutral {
    background-color: rgba(80, 80, 80, 1);
    color: rgb(220, 220, 220);
}

.bvp-pill-good {
    background-color: rgba(45, 140, 60, 1);
    color: rgb(240, 255, 240);
}

.bvp-pill-bad {
    background-color: rgba(160, 50, 50, 1);
    color: rgb(255, 235, 235);
}

.bvp-pill-warn {
    background-color: rgba(170, 130, 30, 1);
    color: rgb(255, 250, 230);
}

.bvp-help-info {
    background-color: rgba(40, 70, 100, 0.6);
    color: rgb(220, 230, 240);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-top: 4px;
    white-space: normal;
}

.bvp-help-warn {
    background-color: rgba(110, 80, 20, 0.7);
    color: rgb(255, 240, 210);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-top: 4px;
    white-space: normal;
}

.bvp-help-error {
    background-color: rgba(120, 30, 30, 0.7);
    color: rgb(255, 220, 220);
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 8px;
    padding-right: 8px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin-top: 4px;
    white-space: normal;
}

.bvp-actions-card {
    flex-direction: row;
}

.bvp-primary-button {
    background-color: rgb(239, 40, 90);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 13px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    flex-grow: 1;
    margin-right: 4px;
}

.bvp-secondary-button {
    background-color: rgb(80, 80, 80);
    color: rgb(255, 255, 255);
    -unity-font-style: bold;
    font-size: 13px;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 12px;
    padding-right: 12px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 6px;
    border-bottom-right-radius: 6px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    flex-grow: 1;
}

.bvp-bar-track {
    background-color: rgb(38, 38, 38);
    border-top-left-radius: 3px;
    border-top-right-radius: 3px;
    border-bottom-left-radius: 3px;
    border-bottom-right-radius: 3px;
    height: 14px;
    flex-grow: 1;
    overflow: hidden;
    margin-top: 2px;
    margin-bottom: 2px;
}

.bvp-bar-fill {
    background-color: rgb(50, 178, 255);
    height: 14px;
    width: 0;
}

.bvp-bar-fill-audio {
    background-color: rgb(230, 130, 50);
}

.bvp-bar-fill-good {
    background-color: rgb(70, 200, 90);
}

.bvp-bar-fill-warn {
    background-color: rgb(220, 180, 40);
}

.bvp-bar-fill-bad {
    background-color: rgb(220, 70, 70);
}

.bvp-bar-row {
    flex-direction: row;
    align-items: center;
    padding-left: 4px;
    padding-right: 4px;
}

.bvp-bar-label {
    color: rgb(220, 220, 220);
    margin-right: 6px;
    min-width: 130px;
}

.bvp-bar-value {
    color: rgb(220, 220, 220);
    -unity-font-style: bold;
    margin-left: 6px;
    min-width: 90px;
    -unity-text-align: middle-right;
}

.bvp-counters {
    background-color: rgba(20, 20, 20, 0.6);
    color: rgb(180, 220, 240);
    font-size: 11px;
    padding-top: 4px;
    padding-bottom: 4px;
    padding-left: 6px;
    padding-right: 6px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    white-space: normal;
}

.bvp-mini-note {
    color: rgb(160, 160, 160);
    font-size: 10px;
    margin-top: 2px;
    margin-left: 4px;
    white-space: normal;
}

.bvp-scroll {
    flex-grow: 1;
}

.bvp-scroll > .unity-scroll-view__content-container {
    flex-grow: 1;
}
