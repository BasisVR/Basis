<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement class="bvp-root">
        <engine:VisualElement name="HeaderCard" class="bvp-card bvp-header-card">
            <engine:Label text="Basis Video Material Output" name="HeaderTitle" selectable="false" class="bvp-header-title"/>
            <engine:Label text="Binds the player's video texture to one or more Renderer material properties" name="HeaderSubtitle" selectable="false" class="bvp-header-subtitle"/>
        </engine:VisualElement>

        <engine:Foldout text="Binding" name="BindingFoldout" value="true" class="bvp-foldout">
            <editor:ObjectField label="Player" name="PlayerField" type="BasisMediaPlayer, BasisMediaPlayer" allow-scene-objects="true"/>
            <editor:ObjectField label="Target Renderer" name="TargetRendererField" type="UnityEngine.Renderer, UnityEngine.CoreModule" allow-scene-objects="true"/>
            <engine:IntegerField label="Material Index" name="MaterialIndexField"/>
            <engine:TextField label="Texture Property Name" name="TexturePropertyField" tooltip="URP uses _BaseMap; legacy BiRP uses _MainTex."/>
            <engine:Toggle label="Use Shared Material" name="UseSharedMaterialField" tooltip="When ON, every renderer using the material will see the video. When OFF, a per-instance copy is created."/>
            <editor:PropertyField name="AdditionalTargetsField" label="Additional Targets" tooltip="Extra renderers/materials driven by the same video. Each entry may override the Texture Property Name; the settings below apply to all targets."/>
        </engine:Foldout>

        <engine:Foldout text="Behavior" name="BehaviorFoldout" value="true" class="bvp-foldout">
            <editor:ObjectField label="Placeholder Texture" name="PlaceholderField" type="UnityEngine.Texture, UnityEngine.CoreModule" allow-scene-objects="true"/>
            <engine:Toggle label="Restore Placeholder On Ended" name="RestoreOnEndedField"/>
            <engine:Toggle label="Flip Vertically" name="FlipVerticallyField" tooltip="Platform frame-origin differences are corrected automatically; only turn this on for content encoded upside-down at source."/>
            <engine:Toggle label="Flip Horizontally" name="FlipHorizontallyField" tooltip="Mirror the video left-right. Use when the screen mesh winding presents the video reversed."/>
        </engine:Foldout>

        <engine:Foldout text="Projection" name="ProjectionFoldout" value="false" class="bvp-foldout">
            <engine:EnumField label="Projection Mode" name="ProjectionModeField" tooltip="Mono/SBS/OU pick the correct UV half via UV transform; Equirect360/VR180/Fisheye set a BASIS_PROJ_* shader keyword for compatible shaders."/>
            <engine:EnumField label="Stereo Eye" name="StereoEyeField" tooltip="Which half of a stereo SBS/OU stream to display."/>
        </engine:Foldout>

        <engine:Foldout text="Aspect" name="AspectFoldout" value="false" class="bvp-foldout">
            <engine:EnumField label="Aspect Mode" name="AspectModeField"/>
            <engine:FloatField label="Display Aspect Override" name="DisplayAspectOverrideField" tooltip="0 = use renderer's localBounds aspect."/>
        </engine:Foldout>

        <engine:Foldout text="Picture" name="PictureFoldout" value="false" class="bvp-foldout">
            <engine:Label text="Bound to MaterialPropertyBlock as _BasisBrightness/Contrast/Saturation/Gamma." name="PictureHelp" class="bvp-help-info"/>
            <editor:PropertyField name="PictureField" label="Picture"/>
        </engine:Foldout>

    </engine:VisualElement>
</engine:UXML>
