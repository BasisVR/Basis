<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement class="bvp-root">
        <engine:VisualElement name="HeaderCard" class="bvp-card bvp-header-card">
            <engine:Label text="Basis Media Streaming" name="HeaderTitle" selectable="false" class="bvp-header-title"/>
            <engine:Label text="URL selection for a Basis Media Player" name="HeaderSubtitle" selectable="false" class="bvp-header-subtitle"/>
        </engine:VisualElement>

        <engine:Foldout text="Stream" name="StreamFoldout" value="true" class="bvp-foldout">
            <engine:TextField label="Stream URL" name="StreamUrlField" tooltip="URL to play when AutoSelectPerPlatform is off."/>
            <engine:Toggle label="Auto Select Per Platform" name="AutoSelectField" tooltip="Pick PcUrl/QuestUrl by build target instead of using StreamUrl."/>
            <engine:TextField label="PC / Standalone URL" name="PcUrlField"/>
            <engine:TextField label="Android / Quest URL" name="QuestUrlField"/>
        </engine:Foldout>

        <engine:Foldout text="Lifecycle" name="LifecycleFoldout" value="true" class="bvp-foldout">
            <engine:Toggle label="Configure On Start" name="ConfigureOnStartField"/>
        </engine:Foldout>

        <engine:VisualElement name="ActionsCard" class="bvp-card bvp-actions-card">
            <engine:Button text="Play" name="ConfigureButton" class="bvp-primary-button"/>
            <engine:Button text="Open Debug Window" name="OpenDebugButton" class="bvp-secondary-button"/>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
