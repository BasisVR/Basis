<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <engine:VisualElement class="bvp-root">
        <engine:VisualElement name="HeaderCard" class="bvp-card bvp-header-card">
            <engine:Label text="Basis Media Networking" name="HeaderTitle" selectable="false" class="bvp-header-title"/>
            <engine:Label text="Cross-client URL / state / position sync" name="HeaderSubtitle" selectable="false" class="bvp-header-subtitle"/>
        </engine:VisualElement>

        <engine:Foldout text="Permissions" name="PermissionsFoldout" value="true" class="bvp-foldout">
            <engine:Toggle label="Admin Only" name="AdminOnlyField" tooltip="If ON, only clients with the basis.mediaplayer.control or * permission may take ownership and control playback. Overrides Allow Anyone To Take Control."/>
            <engine:Toggle label="Allow Anyone To Take Control" name="AllowAnyoneField" tooltip="If ON, any client may take ownership and control playback. If OFF, only the owner can call SetUrl/Play/Stop/Pause/Resume/Seek. Ignored when Admin Only is on."/>
            <engine:Toggle label="Anyone Can Control" name="AnyoneCanControlField" tooltip="If ON, clients WITHOUT the basis.mediaplayer.control (or *) permission may also load URLs and drive playback, and the menu shows them the playback controls. Ignored when Admin Only is on."/>
        </engine:Foldout>

        <engine:Foldout text="Sync" name="SyncFoldout" value="true" class="bvp-foldout">
            <engine:FloatField label="Drift Seek Threshold (s)" name="DriftThresholdField" tooltip="Remote clients seek to catch up when their position drifts more than this. 0 = disable."/>
        </engine:Foldout>

        <engine:Foldout text="Logging" name="LoggingFoldout" value="false" class="bvp-foldout">
            <engine:Toggle label="Verbose Logging" name="VerboseLoggingField"/>
        </engine:Foldout>

        <engine:Foldout text="Live Status" name="StatusFoldout" value="true" class="bvp-foldout">
            <engine:VisualElement class="bvp-status-grid">
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Can Locally Control" class="bvp-status-label"/><engine:Label text="—" name="StatusCanControl" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
                <engine:VisualElement class="bvp-status-row"><engine:Label text="Player Attached" class="bvp-status-label"/><engine:Label text="—" name="StatusHasPlayer" class="bvp-status-pill bvp-pill-neutral"/></engine:VisualElement>
            </engine:VisualElement>
            <engine:Label text="Enter Play Mode in a networked session for live state." name="StatusEditModeHint" class="bvp-help-info"/>
        </engine:Foldout>

        <engine:VisualElement name="UrlCard" class="bvp-card">
            <engine:TextField label="URL" name="UrlField" tooltip="Loads on this player and broadcasts to remotes. Requires ownership (Play Mode only)."/>
            <engine:Button text="Load URL" name="ActLoadUrlButton" class="bvp-primary-button"/>
        </engine:VisualElement>

        <engine:VisualElement name="ActionsCard" class="bvp-card bvp-actions-card">
            <engine:Button text="Play" name="ActPlayButton" class="bvp-primary-button"/>
            <engine:Button text="Pause" name="ActPauseButton" class="bvp-secondary-button"/>
            <engine:Button text="Resume" name="ActResumeButton" class="bvp-secondary-button"/>
            <engine:Button text="Stop" name="ActStopButton" class="bvp-secondary-button"/>
        </engine:VisualElement>
    </engine:VisualElement>
</engine:UXML>
