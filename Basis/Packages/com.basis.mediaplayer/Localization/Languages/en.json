      "key": "settings.media.title",
      "value": "Media Player"
    },
    {
      "key": "settings.media.description",
      "value": "How media players on this machine decode video. These are per-machine settings; they are not part of any world."
    },
    {
      "key": "settings.media.decode",
      "value": "Decode preference"
    },
    {
      "key": "settings.media.decode.tooltip",
      "value": "Which decode route a media player may take. Takes effect the next time a source is opened."
    },
    {
      "key": "settings.media.decode.hardwareFallback",
      "value": "Hardware, fall back to software"
    },
    {
      "key": "settings.media.decode.hardwareOnly",
