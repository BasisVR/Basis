      "key": "menu.servers.welcome.next",
      "value": "Next"
    },
    {
      "key": "menu.servers.welcome.server.title",
      "value": "Your First Server"
    },
    {
      "key": "menu.servers.welcome.server.body",
      "value": "There is no central Basis service — anyone can run a server, and you can host your own right from this panel. So you always have somewhere to go, we run a default server, marked with a ★ at the top of the list below. Pick a username, hit the glowing Connect button, and come say hi!"
    },
    {
      "key": "menu.servers.welcome.ok",
      "value": "Got it!"
    },
