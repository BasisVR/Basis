    {
      "key": "menu.servers.welcome.body",
      "value": "Basis Labs is the living showcase of the Basis Framework — a free, MIT-licensed foundation for building VR games, platforms, and experiences. Explore worlds, wear custom avatars, and meet people while testing features as they're built. Everything here is evolving — your feedback helps shape it."
    },
