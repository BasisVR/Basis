{
  "model": {
    "name": "tcn",
    "num_visemes": 15,
    "layers": 5,
    "channels": 128,
    "kernel_size": 3,
    "dropout": 0.1,
    "normalization": "weight_norm"
  },
  "audio": {
    "sample_rate": 16000,
    "hop_length_ms": 10,
    "window_length_ms": 25,
    "n_mels": 80,
    "fmin": 50,
    "fmax": 8000,
    "n_fft": 1024,
    "normalization": "per_utterance",
    "hop_length_samples": 160,
    "window_length_samples": 400,
    "fps": 100.0
  },
  "training": {
    "batch_size": 32,
    "max_chunk_length_s": 8.0,
    "min_chunk_length_s": 2.0,
    "mixed_precision": true,
    "loss_type": "cross_entropy",
    "class_weighting": true,
    "focal_loss_alpha": 1.0,
    "focal_loss_gamma": 2.0,
    "optimizer": "adamw",
    "learning_rate": 0.0003,
    "betas": [
      0.9,
      0.98
    ],
    "weight_decay": 0.01,
    "scheduler": "onecycle",
    "warmup_ratio": 0.05,
    "max_epochs": 100,
    "early_stopping_patience": 7,
    "early_stopping_metric": "val_f1",
    "specaugment_enabled": true,
    "specaugment_time_mask_max_ms": 20,
    "multi_label": true,
    "target_crossfade_ms": 60,
    "mask_padded_frames": true,
    "viseme_overlap_enabled": true,
    "viseme_overlap_threshold": 1.0,
    "silence_bias": 0.0,
    "silence_energy_gate_db": -60.0,
    "silence_energy_gate_bias": 0.0
  },
  "data": {
    "dataset": "librispeech",
    "splits": [
      "train-clean-100",
      "train-clean-360"
    ],
    "val_split": "dev-clean",
    "test_split": "test-clean",
    "augmentation_enabled": true,
    "noise_snr_range": [
      10,
      30
    ],
    "gain_range": [
      0.8,
      1.2
    ],
    "phoneme_viseme_map": "training/configs/viseme_map_en_us_arpa.json",
    "silence_augment_prob": 0.0,
    "silence_noise_dbfs_range": [
      -60.0,
      -40.0
    ],
    "silence_chunk_length_s": [
      1.0,
      4.0
    ]
  },
  "evaluation": {
    "metrics": [
      "frame_accuracy",
      "macro_f1",
      "confusion_matrix"
    ],
    "compute_latency": true,
    "target_hardware": "cpu",
    "viseme_crossfade_enabled": false,
    "viseme_crossfade_ms": 0,
    "viseme_overlap_enabled": false,
    "viseme_overlap_threshold": 0.0
  },
  "hardware": {
    "device": "cuda",
    "num_workers": 4,
    "pin_memory": true
  },
  "logging": {
    "log_interval": 20,
    "save_interval": 1000,
    "max_checkpoints": 10,
    "log_level": "INFO"
  },
  "tensorboard": {
    "enabled": true,
    "runs_dir": "training/runs",
    "run_name_format": "{experiment_name}_{timestamp}",
    "run_name": "tcn_460h_scratch_2026-03-31_02-16-09",
    "log_scalars": true,
    "log_histograms": false,
    "log_images": false,
    "log_audio": false,
    "scalar_log_interval": 20,
    "histogram_log_interval": 100,
    "image_log_interval": 500
  },
  "experiment": {
    "name": "tcn_460h_scratch",
    "tags": [
      "tcn",
      "viseme",
      "100fps"
    ],
    "notes": "TCN 460h from scratch with augmentation"
  }
}