    fullLicenseText: "Third-party licences: Basis media engine (basis_media)\nRust crates under the Apache License 2.0\n\nThe native plugins under Runtime/Plugins/ link the code below statically.\nTHIRD_PARTY_LICENSES.txt at the package root holds every licence they carry.\n\n------------------------------------------------------------------------------\nApache License 2.0\nUsed by:\n  aead 0.5.2 (MIT OR Apache-2.0), aes 0.8.4 (MIT OR Apache-2.0),\n  aes-gcm 0.10.3 (Apache-2.0 OR MIT), arrayvec 0.7.8 (MIT OR Apache-2.0),\n  assert_matches 1.5.0 (MIT OR Apache-2.0),\n  async-trait 0.1.92 (MIT OR Apache-2.0),\n  atomic-waker 1.1.2 (Apache-2.0 OR MIT), atomig 0.4.3 (MIT OR Apache-2.0),\n  atomig-macro 0.4.0 (MIT OR Apache-2.0), base16ct 0.2.0 (Apache-2.0 OR MIT),\n  base64 0.22.1 (MIT OR Apache-2.0), base64ct 1.8.3 (Apache-2.0 OR MIT),\n  bitflags 1.3.2 (MIT OR Apache-2.0), bitflags 2.13.1 (MIT OR Apache-2.0),\n  bitstream-io 2.6.0 (MIT OR Apache-2.0),\n  block-buffer 0.10.4 (MIT OR Apache-2.0), bstr 1.13.1 (MIT OR Apache-2.0),\n  ccm 0.5.0 (Apache-2.0 OR MIT), cesu8 1.1.0 (Apache-2.0 OR MIT),\n  cfg-if 1.0.4 (MIT OR Apache-2.0), chacha20 0.9.1 (Apache-2.0 OR MIT),\n  chacha20poly1305 0.10.1 (Apache-2.0 OR MIT),\n  cipher 0.4.4 (MIT OR Apache-2.0), claxon 0.4.3,\n  const-oid 0.9.6 (Apache-2.0 OR MIT),\n  cpufeatures 0.2.17 (MIT OR Apache-2.0), crc 3.4.0 (MIT OR Apache-2.0),\n  crc-catalog 2.5.0 (MIT OR Apache-2.0),\n  crypto-bigint 0.5.5 (Apache-2.0 OR MIT),\n  crypto-common 0.1.7 (MIT OR Apache-2.0), ctr 0.9.2 (MIT OR Apache-2.0),\n  curve25519-dalek-derive 0.1.1 (MIT OR Apache-2.0),\n  der 0.7.10 (Apache-2.0 OR MIT), der_derive 0.7.3 (Apache-2.0 OR MIT),\n  deranged 0.5.8 (MIT OR Apache-2.0), digest 0.10.7 (MIT OR Apache-2.0),\n  dimpl 0.7.2 (MIT OR Apache-2.0), displaydoc 0.2.7 (MIT OR Apache-2.0),\n  ecdsa 0.16.9 (Apache-2.0 OR MIT),\n  elliptic-curve 0.13.8 (Apache-2.0 OR MIT),\n  fallible-iterator 0.3.0 (MIT OR Apache-2.0),\n  fastrand 2.5.0 (Apache-2.0 OR MIT), 