{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "74619d1ba56f42d1b4739c5f53f6c09e",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "GradientCircle (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -496.6665954589844,
            "y": -1221.3333740234375,
            "width": 237.33328247070313,
            "height": 400.00006103515627
        }
    },
    "m_Slots": [
        {
            "m_Id": "8c8ea9e040f84da89c95380b4b3a377c"
        },
        {
            "m_Id": "a602ea084c6b4e32b0c2c91fd1f86f3b"
        },
        {
            "m_Id": "8d6b81b7eda8480fa23379765d39df04"
        },
        {
            "m_Id": "cbe9d058ce7346b8a81766216ee90259"
        },
        {
            "m_Id": "7c732a9c4a0d495e859159258c5d961b"
        },
        {
            "m_Id": "c625f80a3bbf4309a5f39ca1d94bb009"
        },
        {
            "m_Id": "1ee6d47eb8cd41e6b261eec2841e6d4e"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": true,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 0,
    "m_FunctionName": "GradientCircle",
    "m_FunctionSource": "5b503562bdd2c7e419069fccead894ed",
    "m_FunctionSourceUsePragmas": true,
    "m_FunctionBody": "float sdf = distance(Position, UV) - Radius;\nfloat circle = 1 - saturate(sdf / fwidth(sdf));\n\nfloat2 gradientDir = float2(cos(Radians),-sin(Radians));\nfloat gradientVal = saturate(dot(UV - Position, gradientDir) / Radius / 2 + 0.5);\n\nfloat4 gradient = lerp(Color1, Color2, gradientVal);\n\n\nRGBA = (gradient * circle);\n"
}

