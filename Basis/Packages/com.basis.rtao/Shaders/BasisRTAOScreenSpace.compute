#pragma kernel BasisRTAOScreenSpaceTrace

#include "Packages/com.unity.render-pipelines.core/ShaderLibrary/Common.hlsl"
#include "Packages/com.basis.rtao/Shaders/BasisRTAOCommon.hlsl"

Texture2DArray<float4> _BasisRtaoPositionTex;
Texture2DArray<float4> _BasisRtaoNormalTex;
RWTexture2DArray<float2> _BasisRtaoResultTex;

float4 _BasisRtaoViewPlane[2];
float4 _BasisRtaoReference;
float4 _BasisRtaoSize;
float4 _BasisRtaoTrace;
float4 _BasisRtaoBias;
float4 _BasisRtaoScreenParams;
int _BasisRtaoRayCount;
int _BasisRtaoViewCount;
int _BasisRtaoFrameIndex;
int _BasisRtaoStereoCoherent;

#define SCREEN_PROJECTION_SCALE _BasisRtaoScreenParams.x
#define SCREEN_MAX_RADIUS _BasisRtaoScreenParams.y
#define SCREEN_MIN_RADIUS _BasisRtaoScreenParams.z

static const float kContrast = 0.6;
static const float kBeta = 0.002;
static const float kEpsilon = 1e-4;

float BasisRtaoViewDepth(float4 plane, float3 positionWS)
{
    return dot(plane.xyz, positionWS) + plane.w;
}

[numthreads(8, 8, 1)]
void BasisRTAOScreenSpaceTrace(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_BasisRtaoSize.x || id.y >= (uint)_BasisRtaoSize.y || id.z >= (uint)_BasisRtaoViewCount)
        return;

    float4 packed = _BasisRtaoPositionTex.Load(int4(id.xy, id.z, 0));
    if (packed.w < 0.5)
    {
        _BasisRtaoResultTex[id] = float2(1.0, 1.0);
        return;
    }

    float3 positionWS = packed.xyz + _BasisRtaoReference.xyz;
    float3 normalWS = BasisRtaoDecodeNormal(_BasisRtaoNormalTex.Load(int4(id.xy, id.z, 0)).xy);

    float viewDistance = length(packed.xyz);
    float2 sequence = BasisRtaoSampleJitter(positionWS, viewDistance, _BasisRtaoBias.z, id, (uint)_BasisRtaoFrameIndex, _BasisRtaoStereoCoherent != 0);
    float rotation = sequence.x * 6.2831853071795864;
    float2 jitter = float2(0.0, sequence.y);

    float radius = _BasisRtaoTrace.y;
    float viewDepth = max(1e-3, BasisRtaoViewDepth(_BasisRtaoViewPlane[id.z], positionWS));
    float radiusPixels = clamp(SCREEN_PROJECTION_SCALE * radius / viewDepth, SCREEN_MIN_RADIUS, SCREEN_MAX_RADIUS);

    uint sampleCount = (uint)max(1, _BasisRtaoRayCount);
    float rcpSampleCount = 1.0 / float(sampleCount);
    float radiusSq = radius * radius;
    float bias = kBeta * viewDepth + _BasisRtaoBias.x;

    float occlusion = 0.0;
    float distanceSum = 0.0;
    uint contributing = 0;

    for (uint i = 0; i < sampleCount; ++i)
    {
        float2 u = BasisRtaoHammersley(i, sampleCount, jitter);
        float angle = rotation + u.x * 6.2831853071795864;
        float sampleRadius = sqrt(saturate(u.y)) * radiusPixels;

        int2 tapCoord = int2(id.xy) + int2(round(float2(cos(angle), sin(angle)) * sampleRadius));
        if (any(tapCoord < 0) || any(tapCoord >= int2(_BasisRtaoSize.xy)))
            continue;

        float4 tapPacked = _BasisRtaoPositionTex.Load(int4(tapCoord, id.z, 0));
        if (tapPacked.w < 0.5)
            continue;

        float3 offset = tapPacked.xyz - packed.xyz;
        float offsetSq = dot(offset, offset);
        if (offsetSq > radiusSq)
            continue;

        occlusion += max(0.0, dot(offset, normalWS) - bias) * rcp(offsetSq + kEpsilon);
        distanceSum += saturate(sqrt(offsetSq) / radius);
        contributing++;
    }

    occlusion = pow(max(0.0, occlusion * radius * rcpSampleCount), kContrast);

    float meanDistance = contributing > 0 ? distanceSum / float(contributing) : 1.0;
    _BasisRtaoResultTex[id] = float2(saturate(1.0 - occlusion), meanDistance);
}
