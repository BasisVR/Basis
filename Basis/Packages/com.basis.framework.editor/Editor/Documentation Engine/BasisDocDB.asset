  - TypeFullName: Basis.Tests.Performance.BasisPerformanceModeLevelTests
    MemberName: BasisPerformanceModeLevelTests
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
