  - TypeFullName: Basis.Scripts.Rendering.BasisGpuOcclusionCulling
    MemberName: BasisGpuOcclusionCulling
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
