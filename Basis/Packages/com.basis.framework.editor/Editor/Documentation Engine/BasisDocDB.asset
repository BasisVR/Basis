  - TypeFullName: BasisNetworkHandleTempBlock
    MemberName: BasisNetworkHandleTempBlock
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 1
