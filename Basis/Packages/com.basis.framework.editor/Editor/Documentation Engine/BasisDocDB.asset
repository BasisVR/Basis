  - TypeFullName: Basis.Scripts.Drivers.BasisHandPoseSampler
    MemberName: SampleJoint
    Kind: Method
    ParamCount: 8
    ParamNames:
    - cells
    - fingerStride
    - gridWidth
    - gridHeight
    - increment
    - fingerIndex
    - jointIndex
    - 2
