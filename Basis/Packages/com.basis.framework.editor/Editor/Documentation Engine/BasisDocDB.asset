  - TypeFullName: BasisMediaPlayerAudio
    MemberName: BasisMediaPlayerAudio
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: MonoBehaviour
    Interfaces:
    - IBasisMediaTickConsumer
