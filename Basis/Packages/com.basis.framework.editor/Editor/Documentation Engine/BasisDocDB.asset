  - TypeFullName: Basis.Tests.IK.
    MemberName: ReplayAcrossReEncode_IsIdenticalToTheOriginal
    Kind: Method
    ParamCount: 1
    ParamNames:
    - BasisDeviceStreamFlags.DeflateBody)
    ParamDocs: []
    BaseTypeName: 
