  - TypeFullName: BasisNetworkServer.BasisNetworkHandleErrorReport
    MemberName: BasisNetworkHandleErrorReport
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
