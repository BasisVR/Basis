  - TypeFullName: Basis.Tests.IK.
    MemberName: Girdle_IsClamped_TwistFree_AndEveryContributorEngages
    Kind: Method
    ParamCount: 1
    ParamNames:
    - StringBuilder(
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
