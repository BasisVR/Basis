  - TypeFullName: Basis.BasisUI.PanelVirtualScrollList
    MemberName: PanelVirtualScrollList
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: MonoBehaviour
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
    IsPartial: 0
