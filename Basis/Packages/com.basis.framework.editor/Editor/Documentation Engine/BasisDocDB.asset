  - TypeFullName: 
    MemberName: CapturePlayerHeight
    Kind: Method
    ParamCount: 1
    ParamNames:
    - BasisLocalHeightCalculator.CalculatePlayerEyeHeight(
    ParamDocs: []
    BaseTypeName: 
