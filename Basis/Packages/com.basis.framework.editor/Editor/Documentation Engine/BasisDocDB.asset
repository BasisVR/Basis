  - TypeFullName: Basis.Tests.IK.
    MemberName: RescaledClips_AreStillAnatomicallySaneHumans_AtEveryMismatch
    Kind: Method
    ParamCount: 1
    ParamNames:
    - List<string>(
    ParamDocs: []
    BaseTypeName: 
