  - TypeFullName: Basis.Tests.IK.
    MemberName: TrackedChest_IsNotDraggedByTheGaze
    Kind: Method
    ParamCount: 1
    ParamNames:
    - TestContext.WriteLine(s_Report
    ParamDocs: []
    BaseTypeName: 
