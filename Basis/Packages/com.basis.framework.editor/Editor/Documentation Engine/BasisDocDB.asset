  - TypeFullName: Basis.Tests.IK.
    MemberName: PoseMetric_UsesAtan2_NotAcos
    Kind: Method
    ParamCount: 3
    ParamNames:
    - 61f)
    - -133f)
    - 6f
    ParamDocs: []
    BaseTypeName: 
