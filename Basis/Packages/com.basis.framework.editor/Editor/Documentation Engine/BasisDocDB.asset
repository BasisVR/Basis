  - TypeFullName: BasisViewConeAvatarJob
    MemberName: BasisViewConeAvatarJob
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: IJobParallelFor
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
    IsPartial: 0
    IsMemberStatic: 0
    IsMemberReadOnly: 0
    IsMemberConst: 0
    IsMemberVirtual: 0
    IsMemberOverride: 0
    Summary: "Burst job: filters AvatarRange based on view-cone direction.\n Only
      players within the specified cone angle (relative to the local\n camera forward)
      keep AvatarRange = true. Players outside the cone\n have AvatarRange set to
      false, causing a fallback avatar.\n Scheduled after distance + cap jobs so
      it acts as a final filter.\n Uses hysteresis: players already visible use a
      wider exit threshold\n to prevent flickering when the camera wobbles near the
      cone boundary."
