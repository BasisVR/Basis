  - TypeFullName: Basis.Tests.IK.
    MemberName: TheTieBand_MovesTheCrossingCut_ByABoundedAndMeasuredAmount
    Kind: Method
    ParamCount: 1
    ParamNames:
    - StringBuilder(
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
