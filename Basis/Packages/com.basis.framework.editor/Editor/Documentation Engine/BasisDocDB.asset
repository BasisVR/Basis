  - TypeFullName: BasisRemoteNetworkDriver
    MemberName: InitialCapacity
    Kind: Field
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
