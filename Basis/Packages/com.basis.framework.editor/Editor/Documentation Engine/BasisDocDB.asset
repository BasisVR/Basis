  - TypeFullName: Basis.Scripts.Avatar.
    MemberName: RemoveOldAvatarAndLoadFallback
    Kind: Method
    ParamCount: 3
    ParamNames:
    - Player
    - Position
    - teardown)."
    ParamDocs:
