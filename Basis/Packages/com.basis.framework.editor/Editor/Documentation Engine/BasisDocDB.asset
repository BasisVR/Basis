  - TypeFullName: Basis.Tests.IK.
    MemberName: ShoulderSolve_IsEquivariantUnderAnyRigidTransform
    Kind: Method
    ParamCount: 1
    ParamNames:
    - List<string>(
    ParamDocs: []
