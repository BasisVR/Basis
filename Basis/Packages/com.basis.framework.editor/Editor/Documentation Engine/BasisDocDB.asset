  - TypeFullName: Basis.Tests.IK.BasisHipHingeCoreTests
    MemberName: BasisHipHingeCoreTests
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
