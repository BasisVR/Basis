  - TypeFullName: BasisBundleReservationTests
    MemberName: BasisBundleReservationTests
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
