  - TypeFullName: Basis.Tests.Sync.
    MemberName: TransmitMeasuresAgainstTheSolvedHand_NotTheAnimatedOne
    Kind: Method
    ParamCount: 1
    ParamNames:
    - BuildProductionPair(
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
