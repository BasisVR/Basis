  - TypeFullName: Basis.Scripts.Debugging.
    MemberName: Action
    Kind: Event
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
