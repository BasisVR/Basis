    MemberName: TibialRotation_DoesNotMoveAStationaryKnee
    Kind: Method
    ParamCount: 1
    ParamNames:
    - hint
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
