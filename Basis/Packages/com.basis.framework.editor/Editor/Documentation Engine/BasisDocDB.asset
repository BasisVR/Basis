    MemberName: ApplySimulatedDeviceForwardMap
    Kind: Method
    ParamCount: 6
    ParamNames:
    - localPosition
    - localRotation
    - replayOffsetPosition
    - replayOffsetRotation
    - scaledPosition
    - scaledRotation
    ParamDocs: []
