  - TypeFullName: Basis.Tests.IK.
    MemberName: Legacy_UnconditionedElbow_SnapsAtFullExtension
    Kind: Method
    ParamCount: 1
    ParamNames:
    - true
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
