  - TypeFullName: Basis.Tests.IK.
    MemberName: AtRest_TheAuthoredClavicleIsRecovered_OnlyWithAMatchedBoneAndBind
    Kind: Method
    ParamCount: 1
    ParamNames:
    - RestDirLocal(isLeft
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
