    MemberName: ReprojectedOffsets_MatchInPlaceCalibration_AcrossDragsAndScales
    Kind: Method
    ParamCount: 1
    ParamNames:
    - 0.01f
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
