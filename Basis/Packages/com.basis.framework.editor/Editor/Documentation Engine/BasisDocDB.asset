  - TypeFullName: Basis.Network.Core.Compression.BasisAvatarChannelLayout
    MemberName: FieldWordMask
    Kind: Field
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
