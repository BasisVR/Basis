  - TypeFullName: Basis.MediaPipe.MediaPipeBodyConverter
    MemberName: MediaPipeBodyConverter
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
