  - TypeFullName: BasisNetworkServer.BasisNetworkingReductionSystem.BasisServerReductionSystemEvents+FastBitSet
    MemberName: FastBitSet
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    Summary: "Lock-free (for normal ops) bitset backed by 32-bit words.\n - Per-bit
      Set/Clear uses CAS on int words.\n - Reads use Volatile.Read.\n - Resizes are
      protected by a lock (rare).\n Length is the number of addressable bits (>=
      highest set index + 1 after EnsureCapacity)."
    Remarks: 
    Returns: 
    Value: 
    Examples: []
    TypeParamNames: []
    TypeParamDocs: []
    ExceptionCrefs: []
    ExceptionDocs: []
