  - TypeFullName: Basis.Tests.IK.
    MemberName: TheGuardStaysLiveForEveryPlausibleExtensionCap
    Kind: Method
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
