  - TypeFullName: BasisJiggleGrabSceneDrag
    MemberName: BasisJiggleGrabSceneDrag
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
