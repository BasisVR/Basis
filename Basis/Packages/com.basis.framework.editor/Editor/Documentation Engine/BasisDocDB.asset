  - TypeFullName: Basis.IK.
    MemberName: LegHint
    Kind: Method
    ParamCount: 8
    ParamNames:
    - frameNow
    - hip
    - footPos
    - legLen
    - isLeft
    - hintPos
    - confidence
    - false
    ParamDocs: []
