  - TypeFullName: Basis.Tests.IK.
    MemberName: AMisStrappedTracker_CannotLiftTheElbowAboveTheAnatomicalCeiling
    Kind: Method
    ParamCount: 1
    ParamNames:
    - StringBuilder(
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
