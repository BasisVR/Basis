  - TypeFullName: Basis.Tests.IK.
    MemberName: WarmupFrameContract_SurvivesRoundTrip
    Kind: Method
    ParamCount: 1
    ParamNames:
    - recording."
    ParamDocs: []
    BaseTypeName: 
