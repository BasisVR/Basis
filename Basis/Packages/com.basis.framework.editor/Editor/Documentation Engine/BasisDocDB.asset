  - TypeFullName: Basis.Tests.IK.
    MemberName: BelowFullExtension_TheCapDoesNotBind
    Kind: Method
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
    IsPartial: 0
