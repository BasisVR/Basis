  - TypeFullName: 
    MemberName: ArmSpanFloorGroundingLift
    Kind: Method
    ParamCount: 4
    ParamNames:
    - avatarUnscaledEye
    - appliedUpScale
    - deviceScale
    - 1e-5f
    ParamDocs: []
    BaseTypeName: 
