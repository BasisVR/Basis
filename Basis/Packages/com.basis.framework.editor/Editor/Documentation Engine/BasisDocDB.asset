  - TypeFullName: Basis.Scripts.Constraints.BasisConstraintClearJob
    MemberName: BasisConstraintClearJob
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: IJobParallelFor
