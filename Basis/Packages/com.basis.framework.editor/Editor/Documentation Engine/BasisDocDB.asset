  - TypeFullName: BasisViewConeAvatarJob
    MemberName: BasisViewConeAvatarJob
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    Summary: "Burst job: filters AvatarRange based on view-cone direction.\n Only
      players within the specified cone angle (relative to the local\n camera forward)
      keep AvatarRange = true. Players outside the cone\n have AvatarRange set to
      false, causing a fallback avatar.\n Scheduled after distance + cap jobs so
      it acts as a final filter."
    Remarks: 
    Returns: 
    Value: 
    Examples: []
    TypeParamNames: []
    TypeParamDocs: []
