  - TypeFullName: Basis.Tests.IK.
    MemberName: ElbowAnatomyLaw_IsEvaluatedInTheTorsoFrame_NotTheWorldFrame
    Kind: Method
    ParamCount: 1
    ParamNames:
    - 0f
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
