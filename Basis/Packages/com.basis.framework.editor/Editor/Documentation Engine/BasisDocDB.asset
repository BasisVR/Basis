  - TypeFullName: Basis.Tests.IK.
    MemberName: GirdleIsRigidInItsParentFrame
    Kind: Method
    ParamCount: 1
    ParamNames:
    - 13f
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
