  - TypeFullName: Basis.Scripts.BasisSdk.Constraints.BasisChainIK
    MemberName: BasisChainIK
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: BasisConstraintBase
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
