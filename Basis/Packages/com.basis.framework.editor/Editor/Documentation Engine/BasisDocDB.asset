  - TypeFullName: Basis.Tests.IK.
    MemberName: UnityRandomState_CannotChangeTheOutput
    Kind: Method
    ParamCount: 1
    ParamNames:
    - BasisSyntheticTrackerParams.FromPreset(BasisSyntheticTrackerPreset.PoorPuck
    ParamDocs: []
    BaseTypeName: 
