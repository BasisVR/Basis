  - TypeFullName: Basis.Scripts.BasisSdk.Interactions.
    MemberName: TryGetPlayerGrasp
    Kind: Method
    ParamCount: 4
    ParamNames:
    - player
    - hand
    - palm
    - 1
    ParamDocs: []
    BaseTypeName: 
