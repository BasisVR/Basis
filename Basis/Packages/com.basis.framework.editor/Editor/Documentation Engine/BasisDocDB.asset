  - TypeFullName: ApplySkeletonRotationsJob
    MemberName: ApplySkeletonRotationsJob
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: IJobParallelForTransform
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
    IsPartial: 0
    IsMemberStatic: 0
    IsMemberReadOnly: 0
    IsMemberConst: 0
    IsMemberVirtual: 0
    IsMemberOverride: 0
    Summary: "Burst job that writes precomputed bone localRotations to transforms.
      Now does only the\n transform side of the work \u2014 the quaternion multiply
      lives in ComputeSkeletonRotationsJob.\n Runs across ALL remote players' bones
      in a single flat TransformAccessArray."
    Remarks: 
    Returns: 
    Value: 
    Examples: []
    TypeParamNames: []
    TypeParamDocs: []
