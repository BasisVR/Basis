  - TypeFullName: Basis.Tests.Sync.BasisSyncDatagramBudgetTests
    MemberName: BasisSyncDatagramBudgetTests
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
