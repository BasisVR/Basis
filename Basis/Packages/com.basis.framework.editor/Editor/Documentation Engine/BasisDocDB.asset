  - TypeFullName: Basis.IK.Mocap.
    MemberName: Slip01
    Kind: Method
    ParamCount: 4
    ParamNames:
    - t
    - hz
    - phaseA
    - zero
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
