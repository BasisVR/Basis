  - TypeFullName: Basis.Scripts.Device_Management.Devices.Pairing.BasisMidpointFusionCore
    MemberName: BasisMidpointFusionCore
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
