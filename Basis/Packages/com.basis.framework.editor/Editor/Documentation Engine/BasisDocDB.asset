  - TypeFullName: Basis.Tests.Remote.BasisNamePlatePoseGateTests
    MemberName: BasisNamePlatePoseGateTests
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
