  - TypeFullName: Basis.Network.Core.
    MemberName: UnreliableQueuePerPeer
    Kind: Method
    ParamCount: 2
    ParamNames:
    - configured
    - 1
    ParamDocs:
    - Value from config; anything above 0 wins and is returned as-is.
    BaseTypeName: 
