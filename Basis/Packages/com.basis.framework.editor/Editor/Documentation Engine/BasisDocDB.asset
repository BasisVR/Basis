  - TypeFullName: Basis.Tests.Sync.BasisFingerCrossRigTests
    MemberName: BasisFingerCrossRigTests
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
