  - TypeFullName: Basis.Network.Server.Generic.BasisNetworkImageCache+CachedImage
    MemberName: Transform
    Kind: Field
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
