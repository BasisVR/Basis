  - TypeFullName: BasisFiniteWatchdog
    MemberName: BasisFiniteWatchdog
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 1
    IsPartial: 0
