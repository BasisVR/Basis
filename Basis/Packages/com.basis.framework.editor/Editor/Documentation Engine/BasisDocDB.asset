  - TypeFullName: 
    MemberName: AdaptiveCutoff
    Kind: Method
    ParamCount: 4
    ParamNames:
    - prevSnapshot
    - targetSnapshot
    - minCutoffHz
    - math.acos(d
    ParamDocs: []
    BaseTypeName: 
