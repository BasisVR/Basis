  - TypeFullName: Basis.Tests.Sync.
    MemberName: NetworkVersion_GatesTheFormatChange
    Kind: Method
    ParamCount: 1
    ParamNames:
    - replaced"
    ParamDocs: []
    BaseTypeName: 
