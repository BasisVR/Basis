  - TypeFullName: ConnectorFetch
    MemberName: ConnectorFetch
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 1
    IsStatic: 0
