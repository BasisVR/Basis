    Platforms: []
  - TypeFullName: Basis.Tests.IK.BasisShoulderSlideTwistTests
    MemberName: BasisShoulderSlideTwistTests
    Kind: Type
    ParamCount: 0
    ParamNames: []
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
