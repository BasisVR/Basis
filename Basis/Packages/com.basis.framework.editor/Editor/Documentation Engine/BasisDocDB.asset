  - TypeFullName: LiteNetLib.
    MemberName: SendUnreliableRawMerge
    Kind: Method
    ParamCount: 6
    ParamNames:
    - data
    - offset
    - length
    - channelNumber
    - -1
    - _channels.Length
    ParamDocs: []
    BaseTypeName: 
