  - TypeFullName: Basis.Tests.IK.
    MemberName: StrapClockAngle_Cancels
    Kind: Method
    ParamCount: 1
    ParamNames:
    - -98f
    ParamDocs: []
    BaseTypeName: 
    Interfaces: []
    IsAbstract: 0
    IsSealed: 0
    IsStatic: 0
