  - TypeFullName: Basis.Tests.IK.
    MemberName: ArmSolve_DegradesGracefully_FarFromWorldOrigin
    Kind: Method
    ParamCount: 1
    ParamNames:
    - base_
    ParamDocs: []
    BaseTypeName: 
