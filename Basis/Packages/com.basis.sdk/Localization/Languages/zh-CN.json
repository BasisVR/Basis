    { "key": "sdk.authoredMotion.field.chainPhaseStep.label", "value": "链相位步进" },
    { "key": "sdk.authoredMotion.field.chainPhaseStep.tooltip", "value": "沿链每个元素累加的相位延迟（弧度）— 产生行波外观。" },
    { "key": "sdk.authoredMotion.field.chainFalloff.label", "value": "链衰减" },
    { "key": "sdk.authoredMotion.field.chainFalloff.tooltip", "value": "沿链每个元素应用的振幅乘数（1 = 无衰减）。" },
    { "key": "sdk.authoredMotion.field.target.label", "value": "目标" },
    { "key": "sdk.authoredMotion.field.target.tooltip", "value": "要驱动的 Transform。由 Rotate 和 Orbit 使用；Oscillate 和 Noise 改用链。" },
    { "key": "sdk.authoredMotion.field.speedDeg.label", "value": "速度 (deg/sec)" },
    { "key": "sdk.authoredMotion.field.speedDeg.tooltip", "value": "绕轴的恒定角速度，单位为度/秒。" },
    { "key": "sdk.authoredMotion.field.pivot.label", "value": "枢轴" },
    { "key": "sdk.authoredMotion.field.pivot.tooltip", "value": "目标围绕其旋转的点。未设置时默认为目标自身的位置。" },
    { "key": "sdk.authoredMotion.field.radius.label", "value": "半径" },
    { "key": "sdk.authoredMotion.field.radius.tooltip", "value": "距枢轴的距离，单位为米。" },
    { "key": "sdk.authoredMotion.field.orbitSpeedDeg.label", "value": "环绕速度 (deg/sec)" },
    { "key": "sdk.authoredMotion.field.orbitSpeedDeg.tooltip", "value": "绕枢轴的公转速度，单位为度/秒。" },
    { "key": "sdk.authoredMotion.field.selectTarget.label", "value": "选择目标" },
    { "key": "sdk.authoredMotion.field.selectTarget.tooltip", "value": "未设置自身目标的选项的默认目标。让单个组件以多种方式摆放同一根骨骼，而指定了自身目标的选项可各自驱动不同骨骼。" },
    { "key": "sdk.authoredMotion.field.options.label", "value": "选项" },
    { "key": "sdk.authoredMotion.field.options.tooltip", "value": "可供选取的加权姿势。每个选项可针对自身骨骼（否则回退到选择目标），并按其权重比例被选中。" },
    { "key": "sdk.authoredMotion.field.idleWeight.label", "value": "空闲权重" },
    { "key": "sdk.authoredMotion.field.idleWeight.tooltip", "value": "'不摆任何姿势'结果的相对权重。较大的值使静止循环（所有目标回到静止）比任何单个选项更有可能。" },
    { "key": "sdk.authoredMotion.field.intervalRange.label", "value": "间隔范围" },
    { "key": "sdk.authoredMotion.field.intervalRange.tooltip", "value": "两次选取之间的时间。X 值设定固定周期（秒）；Y 为保留项。" },
    { "key": "sdk.authoredMotion.field.attack.label", "value": "起音" },
    { "key": "sdk.authoredMotion.field.attack.tooltip", "value": "过渡进入新选定姿势的缓入时间，单位为秒。" },
    { "key": "sdk.authoredMotion.field.release.label", "value": "释音" },
    { "key": "sdk.authoredMotion.field.release.tooltip", "value": "目标回到静止时的缓出时间，单位为秒。" },
    { "key": "sdk.authoredMotion.field.preventRepeats.label", "value": "防止重复" },
    { "key": "sdk.authoredMotion.field.preventRepeats.tooltip", "value": "避免连续两次选取相同选项。确定性选取器尚未遵循此项。" },
    { "key": "sdk.authoredMotion.field.seed.label", "value": "种子" },
    { "key": "sdk.authoredMotion.field.seed.tooltip", "value": "Noise 和 RandomSelect 的随机种子。为 0 时从注册索引派生一个。" },
    { "key": "sdk.authoredMotion.field.noiseSpeed.label", "value": "噪声速度" },
    { "key": "sdk.authoredMotion.field.noiseSpeed.tooltip", "value": "对单纯形噪声场采样的速度。" },
    { "key": "sdk.authoredMotion.field.sequenceTarget.label", "value": "序列目标" },
    { "key": "sdk.authoredMotion.field.sequenceTarget.tooltip", "value": "时间轴所驱动的 Transform。" },
    { "key": "sdk.authoredMotion.field.sequenceRoot.label", "value": "序列根" },
    { "key": "sdk.authoredMotion.field.sequenceRoot.tooltip", "value": "烘焙片段的 Transform 路径在此根下解析（例如片段所针对创作的虚拟形象根）。未设置时默认为此组件的 Transform。" },
    { "key": "sdk.authoredMotion.field.bakedClip.label", "value": "烘焙片段" },
    { "key": "sdk.authoredMotion.field.bakedClip.tooltip", "value": "由片段烘焙器生成的共享只读烘焙曲线资源。驱动源 AnimationClip 所动画的每根骨骼。" },
    { "key": "sdk.authoredMotion.field.keyframes.label", "value": "关键帧" },
    { "key": "sdk.authoredMotion.field.keyframes.tooltip", "value": "用于短动作的内联姿势增量时间轴。分配了烘焙片段时将被忽略。" },
    { "key": "sdk.authoredMotion.field.loop.label", "value": "循环" },
    { "key": "sdk.authoredMotion.field.loop.tooltip", "value": "循环播放序列，或仅播放一次。" },
    { "key": "sdk.authoredMotion.field.sequenceSpeed.label", "value": "速度" },
    { "key": "sdk.authoredMotion.field.sequenceSpeed.tooltip", "value": "烘焙片段的播放速率乘数。1 按创作速度播放，2 为两倍速，0.5 为半速；负值倒放。" },

