    { "key": "projectSetup.firstRun.avatar.header", "value": "Configurazione Avatar — fai così:" },
    { "key": "projectSetup.firstRun.avatar.body", "value": "1) Aggiungi il componente “BasisAvatar” alla radice del tuo avatar.\n2) Imposta punto di vista/altezza occhi come necessario.\n3) Entra in Play e verifica movimento/teletrasporto cliccando su Test In Editor" },
    { "key": "projectSetup.firstRun.avatar.addButton", "value": "Aggiungi BasisAvatar al selezionato" },
    { "key": "projectSetup.firstRun.avatar.docsLink", "value": "Documentazione Avatar" },
    { "key": "projectSetup.firstRun.world.header", "value": "Configurazione mondo — fai così:" },
    { "key": "projectSetup.firstRun.world.body", "value": "1) Aggiungi il componente “BasisScene” a un oggetto radice della scena.\n2) Imposta i punti di spawn e le opzioni della scena nell'Inspector.\n3) Prova in modalità desktop, poi entra in XR con F10/F11." },
    { "key": "projectSetup.firstRun.world.addButton", "value": "Aggiungi BasisScene al selezionato / crea radice" },
    { "key": "projectSetup.firstRun.world.docsLink", "value": "Documentazione mondo" },
    { "key": "projectSetup.firstRun.project.header", "value": "Basi del progetto — note rapide:" },
    { "key": "projectSetup.firstRun.project.body", "value": "• Avatar: aggiungi “BasisAvatar” alla radice del tuo avatar.\n• Mondo: aggiungi “BasisScene” a un oggetto radice della scena.\n• Prop: aggiungi “BasisProp” a qualsiasi GameObject che vuoi si comporti come un prop." },
    { "key": "projectSetup.firstRun.project.addProp", "value": "Aggiungi BasisProp al selezionato" },
    { "key": "projectSetup.firstRun.typeNotFoundTitle", "value": "Tipo non trovato" },
    { "key": "projectSetup.firstRun.typeNotFoundBodyBasisScene", "value": "Impossibile trovare un tipo di componente chiamato “BasisScene”.\n\nAssicurati che i pacchetti Basis siano importati e che il nome del tipo corrisponda." },
    { "key": "projectSetup.firstRun.typeNotFoundBody", "value": "Impossibile trovare un tipo di componente chiamato “{0}”.\n\nSe questo tipo si trova in un namespace, lo scanner di reflection prova tutti gli assembly; verifica che il componente esista e che il pacchetto sia importato." },
    { "key": "projectSetup.firstRun.noSelectionTitle", "value": "Nessuna selezione" },
