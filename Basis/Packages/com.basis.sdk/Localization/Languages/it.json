    { "key": "projectSetup.playXR.foldout", "value": "Modalità Play e basi XR" },
    { "key": "projectSetup.playXR.body", "value": "Entrare in Play in qualsiasi scena caricherà Basis. Il percorso di boot è marcato con [RuntimeInitializeOnLoadMethod(AfterSceneLoad)] e istanzia il prefab Addressable “BasisFramework”.\n\nScorciatoie XR durante Play:\n• F10 → OpenVR (SteamVR)\n• F11 → OpenXR" },
    { "key": "projectSetup.playXR.controlFoldout", "value": "Controlla Boot / Avvio XR" },
    { "key": "projectSetup.playXR.controlBody", "value": "Due flussi comuni:\n1) Impedire a Basis di avviarsi (ottimo per test in Unity puro).\n2) Desktop-first: lascia che Basis si avvii, ma non entrare automaticamente in XR; opt-in tramite F10/F11." },
    { "key": "projectSetup.playXR.openBootButton", "value": "Apri toggle sequenza di boot" },
    { "key": "projectSetup.playXR.bootDialogTitle", "value": "Sequenza di boot" },
    { "key": "projectSetup.playXR.bootDialogBody", "value": "Impossibile trovare BootManagerEditor. Assicurati che si trovi in un assembly Editor." },

    { "key": "projectSetup.docs.inEditorFoldout", "value": "Documentazione API in-editor" },
    { "key": "projectSetup.docs.inEditorBody", "value": "Ogni componente Basis include le proprie note API direttamente nell'Inspector. Seleziona un componente Basis ed espandi il foldout chiamato “Basis API Reference”." },
    { "key": "projectSetup.docs.unityAsmdefLink", "value": "Unity: Assembly Definition Files" },
    { "key": "projectSetup.docs.basisGettingStartedLink", "value": "Basis: Getting Started" },
    { "key": "projectSetup.docs.asmdefFoldout", "value": "Assembly Definitions (asmdef) — Come collegarsi a Basis" },
    { "key": "projectSetup.docs.asmdefIntro", "value": "Mantieni i tempi di compilazione brevi e le dipendenze esplicite. Metti il tuo gameplay in un asmdef di runtime e gli strumenti editor in un asmdef solo Editor." },
    { "key": "projectSetup.docs.runtimeAsmdefHeader", "value": "Asmdef di runtime (template)" },
    { "key": "projectSetup.docs.runtimeAsmdefBody", "value": "Crea Assets/YourGame/YourGame.Runtime.asmdef e aggiungi un riferimento all'assembly runtime di Basis che contiene BasisLocalPlayer." },
    { "key": "projectSetup.docs.editorAsmdefHeader", "value": "Asmdef Editor (template)" },
    { "key": "projectSetup.docs.editorAsmdefBody", "value": "Crea Assets/YourGame/Editor/YourGame.Editor.asmdef, spunta Include Platforms → Editor e fai riferimento a YourGame.Runtime (+ qualsiasi assembly Editor di Basis necessario)." },
    { "key": "projectSetup.docs.asmdefTip", "value": "Suggerimento: Per trovare l'assembly Basis esatto da referenziare, clicca su qualsiasi script Basis e controlla la sua Assembly Definition nell'Inspector. Aggiungi solo ciò che ti serve." },
    { "key": "projectSetup.docs.snippetsFoldout", "value": "Snippet Basis — Giocatore locale, teletrasporto, eventi" },
    { "key": "projectSetup.docs.snippetsIntro", "value": "Incolla questi nel tuo assembly runtime (quello che fa riferimento a Basis). Adatta i namespace al tuo pacchetto Basis." },
    { "key": "projectSetup.docs.snippet.devTeleport", "value": "Teletrasporto alla pressione di un tasto" },
