    { "key": "projectSetup.docs.runtimeAsmdefBody", "value": "Assets/YourGame/YourGame.Runtime.asmdef を作成し、BasisLocalPlayer を含む Basis ランタイムアセンブリへの参照を追加してください。" },
    { "key": "projectSetup.docs.editorAsmdefHeader", "value": "Editor asmdef (テンプレート)" },
