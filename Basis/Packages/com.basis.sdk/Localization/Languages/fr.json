    { "key": "projectSetup.playXR.bootDialogBody", "value": "Impossible de trouver BootManagerEditor. Assurez-vous qu'il est dans un assembly Editor." },

    { "key": "projectSetup.docs.inEditorFoldout", "value": "Documentation API dans l'éditeur" },
    { "key": "projectSetup.docs.inEditorBody", "value": "Chaque composant Basis est livré avec ses propres notes API directement dans l'inspecteur. Sélectionnez un composant Basis et développez le foldout nommé « Basis API Reference »." },
    { "key": "projectSetup.docs.unityAsmdefLink", "value": "Unity : Fichiers Assembly Definition" },
    { "key": "projectSetup.docs.basisGettingStartedLink", "value": "Basis : Démarrage" },
    { "key": "projectSetup.docs.asmdefFoldout", "value": "Assembly Definitions (asmdef) — Comment se brancher à Basis" },
    { "key": "projectSetup.docs.asmdefIntro", "value": "Gardez les temps de compilation courts et les dépendances explicites. Placez votre gameplay dans un asmdef runtime, et les outils éditeur dans un asmdef réservé à l'éditeur." },
    { "key": "projectSetup.docs.runtimeAsmdefHeader", "value": "asmdef runtime (modèle)" },
    { "key": "projectSetup.docs.runtimeAsmdefBody", "value": "Créez Assets/YourGame/YourGame.Runtime.asmdef et ajoutez une référence à l'assembly runtime de Basis qui contient BasisLocalPlayer." },
    { "key": "projectSetup.docs.editorAsmdefHeader", "value": "asmdef Editor (modèle)" },
    { "key": "projectSetup.docs.editorAsmdefBody", "value": "Créez Assets/YourGame/Editor/YourGame.Editor.asmdef, cochez Include Platforms → Editor, et référencez YourGame.Runtime (+ tous les assemblies Editor de Basis dont vous avez besoin)." },
    { "key": "projectSetup.docs.asmdefTip", "value": "Astuce : pour trouver l'assembly Basis exact à référencer, cliquez sur n'importe quel script Basis et vérifiez son Assembly Definition dans l'inspecteur. N'ajoutez que ce dont vous avez besoin." },
    { "key": "projectSetup.docs.snippetsFoldout", "value": "Extraits Basis — Joueur local, téléportation, événements" },
    { "key": "projectSetup.docs.snippetsIntro", "value": "Collez ces extraits dans votre assembly runtime (celui qui référence Basis). Ajustez les namespaces selon votre package Basis." },
