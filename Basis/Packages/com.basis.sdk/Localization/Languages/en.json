    { "key": "projectSetup.docs.inEditorFoldout", "value": "In-Editor API Docs" },
    { "key": "projectSetup.docs.inEditorBody", "value": "Every Basis component ships its own API notes right in the Inspector. Select a Basis component and expand the foldout named “Basis API Reference”." },
    { "key": "projectSetup.docs.unityAsmdefLink", "value": "Unity: Assembly Definition Files" },
    { "key": "projectSetup.docs.basisGettingStartedLink", "value": "Basis: Getting Started" },
    { "key": "projectSetup.docs.asmdefFoldout", "value": "Assembly Definitions (asmdef) — How to hook into Basis" },
    { "key": "projectSetup.docs.asmdefIntro", "value": "Keep compile times lean and dependencies explicit. Put your gameplay in a runtime asmdef, and editor tools in an Editor-only asmdef." },
    { "key": "projectSetup.docs.runtimeAsmdefHeader", "value": "Runtime asmdef (template)" },
    { "key": "projectSetup.docs.runtimeAsmdefBody", "value": "Create Assets/YourGame/YourGame.Runtime.asmdef and add a reference to the Basis runtime assembly that contains BasisLocalPlayer." },
    { "key": "projectSetup.docs.editorAsmdefHeader", "value": "Editor asmdef (template)" },
    { "key": "projectSetup.docs.editorAsmdefBody", "value": "Create Assets/YourGame/Editor/YourGame.Editor.asmdef, tick Include Platforms → Editor, and reference YourGame.Runtime (+ any Basis Editor assemblies you need)." },
    { "key": "projectSetup.docs.asmdefTip", "value": "Tip: To find the exact Basis assembly to reference, click any Basis script and check its Assembly Definition in the Inspector. Add only what you need." },
    { "key": "projectSetup.docs.snippetsFoldout", "value": "Basis Snippets — Local player, teleport, events" },
    { "key": "projectSetup.docs.snippetsIntro", "value": "Paste these into your runtime assembly (the one that references Basis). Adjust namespaces to match your Basis package." },
