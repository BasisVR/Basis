    { "key": "sdk.authoredMotion.field.selectTarget.label", "value": "選擇目標" },
    { "key": "sdk.authoredMotion.field.selectTarget.tooltip", "value": "未設定自身目標的選項的預設目標。讓單個元件以多種方式擺放同一根骨骼，而指定了自身目標的選項可各自驅動不同骨骼。" },
    { "key": "sdk.authoredMotion.field.options.label", "value": "選項" },
