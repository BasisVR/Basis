    { "key": "sdk.authoredMotion.field.preventRepeats.label", "value": "防止重複" },
    { "key": "sdk.authoredMotion.field.preventRepeats.tooltip", "value": "避免連續兩次選取相同選項。確定性選取器尚未遵循此項。" },
    { "key": "sdk.authoredMotion.field.seed.label", "value": "種子" },
